# Configuration
POSTS_PER_DAY=3
RESEARCH_TOPICS=amazon,e-commerce,business,entrepreneurship
TIMEZONE=America/New_York
DATABASE_PATH=./data/posts.db

# Optional: Webhook for notifications
NOTIFICATION_WEBHOOK_URL=
